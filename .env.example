# Local development: use localhost
# Production (Docker): host = booking-db (container name), db = bisp
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/bisp?schema=public"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI chat (Google Gemini API – server-side only, never expose the key to the browser)
# Create a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional; default is a fast model:
# GEMINI_MODEL=gemini-2.5-flash
# Legacy alias (either GEMINI_API_KEY or this works):
# GOOGLE_GEMINI_API_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_SUCCESS_URL=http://localhost:5173/booking/success
STRIPE_CANCEL_URL=http://localhost:5173/booking/cancel
PLATFORM_FEE_PERCENT=10

# Google OAuth (Sign in with Google) – Web client ID only
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email – booking confirmation to learner + tutor (nodemailer + SMTP)
# Gmail: enable 2FA, create App Password at https://myaccount.google.com/apppasswords
# Mailtrap/other: use their SMTP host, port, and credentials
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM="BISP <noreply@example.com>"
