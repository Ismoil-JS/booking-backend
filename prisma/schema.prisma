generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  LEARNER
  TUTOR
  ADMIN
}

model TutorCategory {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  slug  String  @unique
  tutors Tutor[]

  @@index([slug])
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  phone        String?
  userType     UserType  @default(LEARNER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tutor        Tutor?
  learner      Learner?
  sentMessages Message[] @relation("MessageSender")
  conversationParticipants ConversationParticipant[]
  learnerConversations Conversation[] @relation("LearnerConversation")
  tutorConversations Conversation[] @relation("TutorConversation")
}

model Tutor {
  id               Int                @id @default(autoincrement())
  userId           Int                @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       Int?
  category         TutorCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  about            String?
  bio              String?
  costPer30Min     Decimal            @db.Decimal(10, 2)
  profileImage     String?
  certificate      String?
  rating           Decimal?           @db.Decimal(3, 2)
  isApproved       Boolean            @default(false)
  rejectionReason  String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  workExperiences  WorkExperience[]
  slots            Slot[]
  bookings         Booking[]
  reviews          Review[]

  @@index([categoryId])
}

model Slot {
  id        Int       @id @default(autoincrement())
  tutorId   Int
  tutor     Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date   // specific date when this slot is available
  startTime String    // "HH:mm" e.g. "09:00"
  endTime   String    // "HH:mm" e.g. "10:00"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@unique([tutorId, date, startTime])
  @@index([tutorId])
  @@index([date])
}

model WorkExperience {
  id          Int     @id @default(autoincrement())
  tutorId     Int
  tutor       Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  companyName String
  role        String?
  yearsWorked Int?
  createdAt   DateTime @default(now())
}

model Learner {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  unbookedChatWindowStart DateTime?
  bookings  Booking[]
  reviews   Review[]
}

model Booking {
  id              Int      @id @default(autoincrement())
  tutorId         Int
  learnerId       Int
  slotId          Int
  date            DateTime @db.Date
  amountPaid      Decimal  @db.Decimal(10, 2)
  platformFee     Decimal  @default(0) @db.Decimal(10, 2)
  tutorEarning    Decimal  @default(0) @db.Decimal(10, 2)
  stripeSessionId String?  @unique
  meetLink        String?
  paymentStatus   String   @default("paid")
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
  tutor           Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  learner         Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  slot            Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId])
  @@index([tutorId])
  @@index([learnerId])
}

model Review {
  id         Int      @id @default(autoincrement())
  tutorId    Int
  learnerId  Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  tutor      Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([tutorId, learnerId])
  @@index([tutorId])
}

model Conversation {
  id            Int       @id @default(autoincrement())
  kind          String    @default("DIRECT")
  directKey     String    @unique
  learnerUserId Int
  tutorUserId   Int
  learnerUser   User      @relation("LearnerConversation", fields: [learnerUserId], references: [id], onDelete: Cascade)
  tutorUser     User      @relation("TutorConversation", fields: [tutorUserId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([learnerUserId, tutorUserId])
  @@index([lastMessageAt])
  @@index([createdAt])
}

model ConversationParticipant {
  id                Int           @id @default(autoincrement())
  conversationId    Int
  userId            Int
  role              String?
  joinedAt          DateTime      @default(now())
  lastReadMessageId Int?
  mutedUntil        DateTime?
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderUserId   Int
  body           String
  messageType    String       @default("TEXT")
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}
